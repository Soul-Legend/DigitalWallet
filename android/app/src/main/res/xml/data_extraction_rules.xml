<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ data-extraction rules. Wallet master keys, AnonCreds private
  keys, and any cryptographic material under EncryptedStorage MUST NOT be
  included in cloud backups or device-to-device transfers — restoring such
  material on a different device would silently break the link-secret
  invariant that AnonCreds presentations rely on for unlinkability.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
