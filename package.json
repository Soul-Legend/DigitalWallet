{
  "name": "CarteiraIdentidadeAcademica",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint . --max-warnings 100",
    "typecheck": "tsc --noEmit",
    "start": "react-native start",
    "test": "jest --silent",
    "test:verbose": "jest",
    "ci": "npm run typecheck && npm run lint && npm test",
    "postinstall": "patch-package && node scripts/fix-mopro-ffi.js",
    "eas-build-post-install": "patch-package && node scripts/fix-mopro-ffi.js",
    "setup:zkp": "powershell ./scripts/setup_zkp.ps1"
  },
  "dependencies": {
    "@credo-ts/anoncreds": "^0.5.3",
    "@credo-ts/askar": "^0.5.3",
    "@credo-ts/core": "^0.5.3",
    "@credo-ts/react-native": "^0.5.3",
    "@hyperledger/anoncreds-react-native": "^0.2.2",
    "@hyperledger/aries-askar-react-native": "^0.2.1",
    "@noble/ed25519": "^3.0.1",
    "@noble/hashes": "^1.3.3",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "crypto-js": "^4.2.0",
    "expo": "~52.0.49",
    "expo-camera": "~16.0.18",
    "expo-clipboard": "~7.0.1",
    "expo-dev-client": "~5.0.20",
    "fast-text-encoding": "^1.0.6",
    "isomorphic-webcrypto": "^2.3.8",
    "jose": "^5.2.0",
    "mopro-ffi": "github:zkmopro/mopro-react-native-package",
    "react": "18.3.1",
    "react-native": "^0.76.9",
    "react-native-encrypted-storage": "^4.0.3",
    "react-native-fs": "^2.20.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-keychain": "^8.1.2",
    "react-native-qrcode-svg": "^6.3.2",
    "react-native-safe-area-context": "^4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "^15.8.0",
    "snarkjs": "^0.7.6",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/babel-preset": "0.76.5",
    "@react-native/eslint-config": "0.76.5",
    "@react-native/metro-config": "0.76.5",
    "@react-native/typescript-config": "0.76.5",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.2.6",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.6.3",
    "babel-plugin-module-resolver": "^5.0.0",
    "eslint": "^8.19.0",
    "fast-check": "^4.6.0",
    "jest": "^29.6.3",
    "patch-package": "^8.0.1",
    "prettier": "2.8.8",
    "react-test-renderer": "18.3.1",
    "typescript": "~5.3.3"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "@unimodules/core": "npm:empty-npm-package@1.0.0",
    "@unimodules/react-native-adapter": "npm:empty-npm-package@1.0.0"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false,
        "exclude": [
          "react-native-encrypted-storage",
          "react-native-fs",
          "crypto-js"
        ]
      }
    }
  }
}
